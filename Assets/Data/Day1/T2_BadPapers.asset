  newsIfApproved:
  - headline: El Paso Truck Shop Adds Night Shift
    body: '"Finally found a mechanic who shows up early," said the owner. "He asked
      if we had coffee before he asked about the pay."'
    daysLater: 0
    frontPage: 0
  newsIfRejected:
  - headline: El Paso Truck Shop Fills Mechanic Job
    body: A young man arrived at noon, out of breath, two hours late. "I told him
      we'd call him," said the owner. "He wrote his number on my hand. Twice."
    daysLater: 1
    frontPage: 0
  newsIfImprisoned:
  - headline: "Ju\xE1rez Man Reports Truck \"Missing\" for Third Time This Year"
    body: Ernesto Valdez says he lent it to family. "They always bring it back,"
      he said. "Usually."
    daysLater: 0
    frontPage: 0
