    frontPage: 0
  newsIfRejected:
  - headline: "San Antonio Quincea\xF1era Ends Early"
    body: The birthday girl left her own party before the cake. One chair at the
      family table stayed empty all night.
    daysLater: 0
    frontPage: 0
  newsIfImprisoned:
  - headline: Otero County Detention Facility Reaches Capacity
    body: Among the newest detainees is a 71-year-old woman. Staff say she has been
      teaching the guards to cook.
    daysLater: 0
