  returnVisits: []
  bribeAmount: 0
  bribeLine: 
  newsIfApproved:
  - headline: Las Cruces Wedding Goes Until Dawn
    body: Neighbors complained about a trumpet at 4 a.m. Nobody called the police.
      Some of them danced.
    daysLater: 0
    frontPage: 0
  newsIfRejected:
  - headline: Las Cruces Wedding Proceeds Without Band
    body: The bride walked down the aisle to music from a phone. It cut out halfway.
      Someone got a text.
    daysLater: 0
    frontPage: 0
  newsIfImprisoned:
  - headline: Detention Center Guards Request Earplugs
    body: Staff describe a detainee who hums the same song every night. "It's beautiful,"
      said one guard. "That's the problem."
    daysLater: 0
    frontPage: 0
