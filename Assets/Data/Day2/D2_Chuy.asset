  newsIfApproved:
  - headline: Commuters Report Strangers Asking About Their Routes
    body: "Drivers who cross every day say men at Ju\xE1rez gas stations have been
      asking about schedules. One offered to pay for a woman's gas. \"Nobody pays
      for your gas,\" she said."
    daysLater: 0
    frontPage: 0
  newsIfRejected:
  - headline: 'Diesel Shop Owner: "Can''t Find Anyone Reliable"'
    body: '"The good ones get stuck at the bridge," he said. "Then somebody else
      gets to them first."'
    daysLater: 0
    frontPage: 0
  newsIfImprisoned:
  - headline: Brake Rotors Entered Into Evidence; Charges Dropped
    body: A spokesperson confirmed the parts were "just brake rotors." The truck's
      owner could not be reached. His cousin says he is "thinking about some offers."
    daysLater: 0
    frontPage: 0
