  bribeLine: 
  newsIfApproved:
  - headline: Masked Wrestler Keeps Title in El Paso
    body: He dedicated the win to his mother, who was not in attendance. "She doesn't
      watch," he said. "She prays."
    daysLater: 0
    frontPage: 0
  newsIfRejected:
  - headline: El Paso Lucha Card Goes On Without Headliner
    body: El Gringo Loco declared himself champion by default, then left early to
      file a tax extension.
    daysLater: 0
    frontPage: 0
  newsIfImprisoned:
  - headline: Detainee Refuses to Remove Mask for Booking Photo
    body: After six hours, officials agreed to photograph him from behind. "Most
      polite man we've ever had," said a guard.
    daysLater: 0
    frontPage: 0
