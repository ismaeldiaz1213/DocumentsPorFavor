  newsIfApproved:
  - headline: 'Letter to the Editor: "Secure Our Border"'
    body: "\"Anybody can waltz right in. Nobody checks a thing.\" G. Hutchins, Las
      Cruces. P.S. \"Dr. Ram\xEDrez in Ju\xE1rez does crowns for $300. Ask for Lupe.\""
    daysLater: 0
    frontPage: 0
  newsIfRejected:
  - headline: "Las Cruces Man's Video About \"Night in Ju\xE1rez\" Goes Viral"
    body: In 47 minutes he praises the tacos, the hotel staff, and a stranger who
      lent him a phone charger. He ends by calling for a wall.
    daysLater: 0
    frontPage: 0
  newsIfImprisoned:
  - headline: County Commission Candidate Suspends Campaign
    body: Gary Hutchins, who ran on border security, says he needs "time with family."
      Reporters described his new teeth as "very white."
    daysLater: 0
    frontPage: 0
