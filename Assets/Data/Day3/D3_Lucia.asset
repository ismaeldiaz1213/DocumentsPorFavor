  newsIfApproved:
  - headline: First Baby of August at Thomason Is a Girl
    body: Seven pounds, two ounces. Her father fainted. Her mother says she "already
      has opinions."
    daysLater: 0
    frontPage: 0
  newsIfRejected:
  - headline: Baby Born in Car on the Bridge of the Americas
    body: "Traffic stopped both ways for forty minutes. Mother and daughter were
      taken to a hospital in Ju\xE1rez. The father watched from the other side."
    daysLater: 0
    frontPage: 1
  newsIfImprisoned:
  - headline: Detainee Gives Birth in Holding Cell
    body: No medical staff were on duty. A spokesperson said the matter is "under
      review." The infant is a U.S. citizen.
    daysLater: 0
    frontPage: 1
