  newsIfApproved:
  - headline: Bride Walks Down the Aisle With Father in Dress Uniform
    body: Guests say he kept looking at the doors. He danced anyway.
    daysLater: 0
    frontPage: 0
  newsIfRejected:
  - headline: Deported Veterans Hold Vigil at Friendship Park
    body: One man held a phone up to the fence for an hour. On the screen, someone
      on the other side was getting married.
    daysLater: 0
    frontPage: 1
  newsIfImprisoned:
  - headline: Veteran, 58, Faces Federal Reentry Charge
    body: Prosecutors are seeking twenty years. At his first hearing he wore a borrowed
      suit and stood when the judge came in. Nobody else did.
    daysLater: 0
    frontPage: 1
